{
  "name": "otepad",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal free temporary note-taking app for you - not your regular text editor.",
  "scripts": {
    "dev": "vite",
    "theme:build": "astryx theme build src/theme/otepadTheme.ts -o src/theme/otepad.css",
    "build": "npm run theme:build && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
